#! /bin/sh
# Sets up the shared memory stack on this host: clones the notes repo if it isn't
# there yet, creates a folder per space, builds and starts the containers, then
# registers each space's folder as its Basic Memory project.
# Run from a clone of this repository after creating memory/.env: ./install
set -eu

BASEDIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
STACK="$BASEDIR/memory"

[ -f "$STACK/.env" ] || { echo "install: create $STACK/.env from .env.example first" >&2; exit 1; }

env_value() {
    sed -n "s/^$1=//p" "$STACK/.env" | tail -n 1
}

NOTES_DIR=$(env_value NOTES_DIR)
NOTES_DIR=${NOTES_DIR:-./notes}
case "$NOTES_DIR" in
    /*) ;;
    *) NOTES_DIR="$STACK/${NOTES_DIR#./}" ;;
esac

if [ ! -d "$NOTES_DIR/.git" ]; then
    NOTES_REPO=$(env_value NOTES_REPO)
    [ -n "$NOTES_REPO" ] || { echo "install: NOTES_REPO is not set in .env" >&2; exit 1; }
    git clone "$NOTES_REPO" "$NOTES_DIR"
fi

for space in dev netadmin; do
    mkdir -p "$NOTES_DIR/$space"
    [ -e "$NOTES_DIR/$space/README.md" ] || printf '# %s\n\nNotes for the %s space.\n' "$space" "$space" > "$NOTES_DIR/$space/README.md"
done

cd "$STACK"
docker compose up -d --build

for space in dev netadmin; do
    container="basic-memory-$space"
    docker exec "$container" basic-memory project create main /app/data 2>/dev/null || true
    docker exec "$container" basic-memory project set-default main 2>/dev/null || true
    docker exec "$container" basic-memory reindex 2>/dev/null || true
done

echo "install: done. MCP endpoints: https://<MEMORY_HOST>/dev/mcp and /netadmin/mcp; wiki: https://<WIKI_HOST>/"
