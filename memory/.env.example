# Copy to .env (next to docker-compose.yaml) and fill in. Never commit .env.

# Where the notes repo is cloned on the host. It must contain dev/ and netadmin/.
NOTES_DIR=./notes
# The notes repo the backup pushes to (used by ./install to clone it).
NOTES_REPO=git@github.com:credfeto/credfeto-memory-notes.git
# Read/write deploy key for the notes repo, on the host.
BACKUP_SSH_KEY=/path/to/notes-deploy-key
BACKUP_GIT_NAME=Memory Backup
BACKUP_GIT_EMAIL=memory-backup@example.invalid
BACKUP_INTERVAL_SECONDS=300

# User the wiki and backup run as. Basic Memory runs as UID/GID 1000, so keep these 1000
# unless the notes folder is owned by someone else.
PUID=1000
PGID=1000

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
MEMORY_HOST=memory.example.lan
WIKI_HOST=memory-wiki.example.lan

# Basic-auth users per route, in htpasswd format (htpasswd -nbB user password).
# Double every $ in the hash ($$) so compose doesn't expand it.
MEMORY_DEV_USERS=
MEMORY_NETADMIN_USERS=
WIKI_USERS=

BASIC_MEMORY_TAG=latest
GOLLUM_TAG=latest
BASIC_MEMORY_LOG_LEVEL=INFO
